{
	"version": 2,
	"builds": [
		{
			"src": "api/index.js",
			"use": "@vercel/node"
		}
	],
	"routes": [
		{
			"src": "/scripts/(.*)",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable",
				"content-type": "application/javascript"
			},
			"dest": "/scripts/$1"
		},
		{
			"src": "/(.*)",
			"dest": "api/index.js"
		}
	]
}
