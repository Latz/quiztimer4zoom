<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Quiztimer 4 Zoom</title>
		<meta name="referrer" content="no-referrer" />
		<script type="text/javascript" src="/scripts/sdk.js" defer></script>
		<script src="/quiztimer-script.js" type="module"></script>
		<link rel="stylesheet" href="/quiztimer-styles.css" />
	</head>
	<body>
		<div id="container">
			<div id="actions">
				<div class="div1">
					<button id="btn_startStop" class="ripple-button">Start</button>
				</div>
				<div class="div2"><button id="btn_continue">Weiter</button></div>
				<div class="div3"><button id="btn_20sec">20 Sek.</button></div>
				<div class="div4"><button id="btn_30sec">30 Sek.</button></div>
			</div>
			<div id="subActions">
				<progress id="countdown" max="100" value="100"></progress>
				<button title="Optionen" id="btn_options">🛠️</button>
				<button title="Über Quiztimer4Zoom" id="btn_help">❓</button>
				<button title="Panik! Time zurücksetzen." id="btn_panic">💥</button>
			</div>

			<div id="options">
				<details id="position">
					<summary class="smallHeading">Position</summary>
					<div id="corners">
						<div id="positionCorners">
							<button id="posTopLeft" aria-label="Position Top Left">🡤</button>
							<button id="posTopRight" aria-label="Position Top Right">🡥</button>
							<button id="posBottomLeft" aria-label="Position Bottom Left">🡧</button>
							<button id="posBottomRight" aria-label="Position Bottom Right">🡦</button>
						</div>
					</div>
				</details>

				<details>
					<summary class="smallHeading">Timer size</summary>

					<div id="timerSize">
						<button class="btn_timerSize" id="btn_timerSizeMinusFast" title="Smaller fast">&lt;&lt;</button>
						<button class="btn_timerSize" id="btn_timerSizeMinus" title="Smaller">&lt;</button>
						<span id="val_timerSize_container"> </span>
						<button class="btn_timerSize" id="btn_timerSizePlus" title="Bigger">&gt;</button>
						<button class="btn_timerSize" id="btn_timerSizePlusFast" title="Bigger fast">&gt;&gt;</button>
					</div>
				</details>
				<details>
					<summary class="smallHeading">Color</summary>
					<div class="colorHeading">Standard</div>

					<div class="colorcontainer">
						<section class="colorcontainer">
							<!-- Standard -->
							<div>
								<input type="color" id="colorSelectorNumberStandard" />
							</div>
							<div>
								<input type="color" id="colorSelectorBackgroundStandard" />
							</div>
							<div class="number">Foreground</div>
							<div class="background">Background</div>
							<div class="example" id="colorExampleStandard">20</div>
						</section>
					</div>

					<div class="colorHeading">Warning</div>
					<div class="colorcontainer">
						<section class="colorcontainer">
							<!-- Warning -->
							<div>
								<input type="color" id="colorSelectorNumberWarning" />
							</div>
							<div>
								<input type="color" id="colorSelectorBackgroundWarning" />
							</div>
							<div class="number">Foreground</div>
							<div class="background">Background</div>
							<div class="example" id="colorExampleWarning">20</div>
						</section>
					</div>

					<div class="colorHeading">Timeout</div>
					<div class="colorcontainer">
						<section class="colorcontainer">
							<!-- Warning -->
							<div>
								<input type="color" id="colorSelectorNumberTimeout" />
							</div>
							<div>
								<input type="color" id="colorSelectorBackgroundTimeout" />
							</div>
							<div class="number">Foreground</div>
							<div class="background">Background</div>
							<div class="example" id="colorExampleTimeout">20</div>
						</section>
					</div>
				</details>
				<hr />
			</div>
		</div>
	</body>
</html>
